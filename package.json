{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run open-browser && next dev",
    "open-browser": "open http://localhost:3000",
    "build": "next build",
    "build:check": "next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky",
    "format": "prettier --write .",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "pre-push": "npm run build:check"
  },
  "dependencies": {
    "@fontsource/mulish": "^5.1.1",
    "@graphql-codegen/cli": "^5.0.4",
    "@graphql-codegen/typescript": "^4.1.3",
    "@graphql-codegen/typescript-operations": "^4.4.1",
    "@vercel/analytics": "^1.5.0",
    "framer-motion": "^12.4.2",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "next": "15.1.7",
    "next-auth": "^4.24.11",
    "prettier": "^3.5.0",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
