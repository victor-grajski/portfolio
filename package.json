{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:check": "NEXT_DIST_DIR=.next-build-check next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "format": "prettier --write .",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "clean": "rm -rf .next .next-build-check node_modules/.cache",
    "clean:dev": "npm run clean && npm run dev",
    "clean:build": "npm run clean && npm run build:check"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "@fontsource/mulish": "^5.1.1",
    "@graphql-codegen/cli": "^5.0.4",
    "@graphql-codegen/typescript": "^4.1.3",
    "@graphql-codegen/typescript-operations": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.4.2",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "next": "^16.1.6",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "prettier": "^3.5.0",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
